<!DOCTYPE html>
<html>
<head>
    <title>HIGH TIDE BOOKS // EVENTS</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="palm-tree"></div>
        <a href="/"><- Back to Home</a>
        <h1>High Tide Events</h1>

        <% if (!currentCustomer) { %>
            <div class="auth-section">
                <h2>Join an Event</h2>
                <div class="auth-grid">
                    <div class="auth-box">
                        <h3>Sign In</h3>
                        <form action="/login" method="POST" id="loginForm">
                            <input list="customer-list" name="customerSearch" id="customerSearch" placeholder="Type your name to sign in..." autocomplete="off">
                            <datalist id="customer-list">
                                <% customers.forEach(c => { %>
                                    <option value="<%= c.first_name %> <%= c.last_name %>" data-id="<%= c.id %>"></option>
                                <% }) %>
                            </datalist>
                            <input type="hidden" name="customerId" id="customerId">
                        </form>
                        <script>
                            document.getElementById('customerSearch').addEventListener('input', function(e) {
                                const val = e.target.value;
                                const list = document.getElementById('customer-list');
                                const opts = list.options;
                                for (let i = 0; i < opts.length; i++) {
                                    if (opts[i].value === val) {
                                        document.getElementById('customerId').value = opts[i].getAttribute('data-id');
                                        document.getElementById('loginForm').submit();
                                        break;
                                    }
                                }
                            });
                        </script>
                    </div>
                    <div class="auth-box">
                        <h3>New Member</h3>
                        <form action="/register" method="POST">
                            <input type="text" name="first_name" placeholder="First Name" required>
                            <input type="text" name="last_name" placeholder="Last Name" required>
                            <input type="email" name="email" placeholder="Email Address" required>
                            <button type="submit">Join & Attend</button>
                        </form>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="logged-in-bar" style="display: flex; justify-content: space-between; align-items: center;">
                <span>Active Session: <%= currentCustomer.first_name %> <%= currentCustomer.last_name %></span>
                <form action="/logout" method="POST" style="margin: 0;">
                    <button type="submit" style="background: transparent; border: 1px solid #1d5a4d; color: #1d5a4d; padding: 5px 15px;">Logout</button>
                </form>
            </div>
        <% } %>
        
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <h2>Store Events</h2>
            <div style="font-size: 0.8rem; color: #888; text-transform: uppercase; letter-spacing: 1px;">
                * System dashboard: Live Attendance Tracks
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th style="text-align: right;">Price</th>
                    <th style="text-align: center;">Spots</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% if (events.length === 0) { %>
                    <tr><td colspan="6" style="text-align: center; color: #888; padding: 40px;">No upcoming events at this time.</td></tr>
                <% } %>
                <% events.forEach(e => { %>
                    <%
                        const spotsLeft = parseInt(e.spots_left);
                        const soldOut = spotsLeft <= 0;
                        const almostFull = !soldOut && spotsLeft <= Math.max(3, e.max_attendees * 0.1);
                    %>
                    <tr>
                        <td>
                            <div style="font-weight: 600;"><%= e.name %></div>
                            <div style="font-size: 0.75rem; color: var(--secondary); text-transform: uppercase; letter-spacing: 1px; margin-top: 2px;"><%= e.event_type %></div>
                            <% if (e.description) { %>
                                <div style="font-size: 0.85rem; color: #666; font-weight: normal; margin-top: 3px;"><%= e.description %></div>
                            <% } %>
                        </td>
                        <td>
                            <%= e.event_date.toDateString() %>
                            <span style="font-size: 0.85rem; color: #666;">@ <%= e.event_date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                        </td>
                        <td><%= e.location %></td>
                        <td style="text-align: right; font-variant-numeric: tabular-nums;">
                            <strong><%= parseFloat(e.ticket_price).toFixed(2) %> €</strong>
                            <% if (parseFloat(e.cost_per_person) > 0) { %>
                                <div style="font-size: 0.75rem; color: #888;">incl. ingredients</div>
                            <% } %>
                        </td>
                        <td style="text-align: center;">
                            <span style="background: <%= soldOut ? '#f0d9d9' : (almostFull ? '#fdf6e3' : 'var(--background)') %>; padding: 2px 10px; border-radius: 12px; font-weight: 600;">
                                <%= e.attendees %> / <%= e.max_attendees %>
                            </span>
                            <% if (soldOut) { %>
                                <div style="font-size: 0.75rem; color: var(--accent); font-weight: bold; margin-top: 3px;">FULL</div>
                            <% } else if (almostFull) { %>
                                <div style="font-size: 0.75rem; color: var(--accent); margin-top: 3px;">only <%= spotsLeft %> left</div>
                            <% } %>
                        </td>
                        <td style="text-align: right;">
                            <% if (currentCustomer) { %>
                                <% if (bookedEventIds.includes(e.id)) { %>
                                    <span style="background: var(--secondary); color: #1d5a4d; padding: 5px 15px; border-radius: 4px; font-weight: bold;">BOOKED</span>
                                <% } else if (soldOut) { %>
                                    <span style="color: #888; font-size: 0.85rem;">Sold out</span>
                                <% } else { %>
                                    <form action="/events/register" method="POST">
                                        <input type="hidden" name="event_id" value="<%= e.id %>">
                                        <button type="submit">Reserve Spot</button>
                                    </form>
                                <% } %>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

    </div>
</body>
</html>