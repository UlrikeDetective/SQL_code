<!DOCTYPE html>
<html>
<head>
    <title>High Tide Books // Management</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <a href="/"><- Back to Home</a>
        <h1>Store Management</h1>

        <!-- FINANCIAL SUMMARY BAR -->
        <div style="background: #eff6f6; padding: 20px; border-radius: 12px; border: 1px solid var(--secondary); margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; gap: 30px; align-items: center;">
                <strong style="color: var(--primary); font-size: 1.1rem;">Monthly Snapshot:</strong>
                <div>
                    <div style="font-size: 0.7rem; color: #888; text-transform: uppercase;">Sales</div>
                    <div style="font-weight: bold;"><%= stats.currentMonthSales %> €</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: #888; text-transform: uppercase;">Tickets</div>
                    <div style="font-weight: bold;"><%= stats.currentMonthTickets %></div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: #888; text-transform: uppercase;">Net Profit</div>
                    <div style="font-weight: bold; color: <%= stats.currentMonthNet >= 0 ? 'var(--secondary)' : 'var(--accent)' %>;">
                        <%= stats.currentMonthNet.toFixed(2) %> €
                    </div>
                </div>
            </div>
            <a href="/admin/financials" style="background: var(--primary); color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Full Financials -></a>
        </div>

        <!-- BUSINESS INTELLIGENCE DASHBOARD -->
        <h2 style="border-bottom: 2px solid var(--secondary); padding-bottom: 10px; margin-top: 40px;">Business Intelligence Dashboard</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 50px;">
            
            <!-- Out of Stock -->
            <div style="background: #fff; border: 1px solid #ffcccc; padding: 20px; border-radius: 8px;">
                <h3 style="color: #cc0000; font-size: 1rem; margin-top: 0;">⚠️ Out of Stock</h3>
                <ul style="padding-left: 20px; font-size: 0.85rem;">
                    <% if (stats.outOfStock.length === 0) { %><li style="color: #888;">No stock issues found.</li><% } %>
                    <% stats.outOfStock.forEach(b => { %>
                        <li><%= b.title %></li>
                    <% }) %>
                </ul>
            </div>

            <!-- Best Sellers -->
            <div style="background: #fff; border: 1px solid var(--border); padding: 20px; border-radius: 8px;">
                <h3 style="color: var(--primary); font-size: 1rem; margin-top: 0;">⭐ Top Sellers (Volume)</h3>
                <ul style="padding-left: 20px; font-size: 0.85rem;">
                    <% stats.bestSellers.forEach(b => { %>
                        <li><%= b.title %> (<%= b.total_sold %> units)</li>
                    <% }) %>
                </ul>
            </div>

            <!-- Best Selling Authors -->
            <div style="background: #fff; border: 1px solid var(--border); padding: 20px; border-radius: 8px;">
                <h3 style="color: var(--secondary); font-size: 1rem; margin-top: 0;">✍️ Top Authors</h3>
                <ul style="padding-left: 20px; font-size: 0.85rem;">
                    <% stats.topAuthors.forEach(a => { %>
                        <li><%= a.first_name %> <%= a.last_name %> (<%= a.total_sold %> units)</li>
                    <% }) %>
                </ul>
            </div>

            <!-- Zero Sales -->
            <div style="background: #fff; border: 1px solid var(--border); padding: 20px; border-radius: 8px;">
                <h3 style="color: #888; font-size: 1rem; margin-top: 0;">📉 Zero Sales (Action Required)</h3>
                <ul style="padding-left: 20px; font-size: 0.85rem; color: #666;">
                    <% stats.zeroSales.forEach(b => { %>
                        <li><%= b.title %></li>
                    <% }) %>
                </ul>
            </div>

            <!-- Top Customers -->
            <div style="background: #fff; border: 1px solid #d4edda; padding: 20px; border-radius: 8px;">
                <h3 style="color: #28a745; font-size: 1rem; margin-top: 0;">🏆 VIP Customers</h3>
                <ul style="padding-left: 20px; font-size: 0.85rem;">
                    <% stats.topSpenders.forEach(c => { %>
                        <li><%= c.first_name %> <%= c.last_name %> ($<%= c.total_spent %>)</li>
                    <% }) %>
                </ul>
            </div>

            <!-- Inactive Customers -->
            <div style="background: #fff; border: 1px solid #fff3cd; padding: 20px; border-radius: 8px;">
                <h3 style="color: #856404; font-size: 1rem; margin-top: 0;">⏳ Inactive/Potential Churn</h3>
                <ul style="padding-left: 20px; font-size: 0.85rem;">
                    <% stats.inactiveCustomers.forEach(c => { %>
                        <li title="Last Order: <%= c.last_order ? c.last_order.toLocaleDateString() : 'Never' %>">
                            <%= c.first_name %> <%= c.last_name %> (<%= c.email %>)
                        </li>
                    <% }) %>
                </ul>
            </div>
        </div>
        
        <!-- Management Grid -->
        <div style="display: flex; gap: 30px; margin-bottom: 50px; background: var(--background); padding: 30px; border-radius: 8px; flex-wrap: wrap;">
            
            <!-- Add Book Form -->
            <div style="flex: 2; min-width: 400px;">
                <h3>Add New Book</h3>
                <form action="/admin/add-book" method="POST">
                    <input type="text" name="title" placeholder="Book Title" required>
                    <div style="display: flex; gap: 10px;">
                        <input type="text" name="author_first_name" placeholder="Author First Name" required>
                        <input type="text" name="author_last_name" placeholder="Author Last Name" required>
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <input type="text" name="genre_name" placeholder="Genre" required style="flex: 1;">
                        <input type="text" name="isbn" placeholder="ISBN (optional)" style="flex: 1;">
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <input type="number" step="0.01" name="price" placeholder="Price" required style="flex: 1;">
                        <input type="number" name="stock" placeholder="Initial Stock" required style="flex: 1;">
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <input type="number" name="year" placeholder="Released Year" required style="flex: 1;">
                        <input type="number" name="pages" placeholder="Number of Pages" style="flex: 1;">
                    </div>
                    <input type="text" name="hashtags" placeholder="Hashtags (e.g. #surfing #waves #japan)" style="width: 100%; margin-top: 5px;">
                    <button type="submit" style="width: 100%; margin-top: 10px;">Add to Catalog</button>
                </form>
            </div>
            
            <!-- Event & Restock Column -->
            <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 30px;">
                <div>
                    <h3>Create Event</h3>
                    <form action="/admin/add-event" method="POST">
                        <input type="text" name="name" placeholder="Event Name" required>
                        <input type="datetime-local" name="date" required>
                        <input type="text" name="location" placeholder="Location">
                        <input type="text" name="description" placeholder="Description (optional)">
                        <select name="event_type_id" required>
                            <% eventTypes.forEach(t => { %>
                                <option value="<%= t.id %>">
                                    <%= t.name %> - <%= parseFloat(t.ticket_price).toFixed(2) %> €, max <%= t.max_attendees %>
                                </option>
                            <% }) %>
                        </select>
                        <details style="margin-top: 8px;">
                            <summary style="cursor: pointer; font-size: 0.8rem; color: #888;">Override price / cost / capacity for this one event</summary>
                            <p style="font-size: 0.75rem; color: #888; margin: 8px 0;">Leave blank to use the event type's values.</p>
                            <input type="number" step="0.01" min="0" name="ticket_price" placeholder="Ticket price €">
                            <input type="number" step="0.01" min="0" name="cost_per_person" placeholder="Cost per person € (ingredients)">
                            <input type="number" step="0.01" min="0" name="fixed_cost" placeholder="Fixed cost € (licence, DJ, guest)">
                            <input type="number" step="1" min="1" name="max_attendees" placeholder="Max people">
                        </details>
                        <button type="submit" style="width: 100%; margin-top: 10px;">Schedule Event</button>
                    </form>
                </div>
                <div>
                    <h3>Restock Inventory</h3>
                    <form action="/admin/restock" method="POST">
                        <input list="book-list" id="bookSearch" placeholder="Search book to restock..." autocomplete="off" required>
                        <datalist id="book-list">
                            <% books.forEach(b => { %>
                                <option value="<%= b.title %>" data-id="<%= b.id %>"></option>
                            <% }) %>
                        </datalist>
                        <input type="hidden" name="book_id" id="bookId">
                        <input type="number" name="additional_stock" placeholder="Quantity to add" required>
                        <button type="submit" style="width: 100%; background-color: var(--secondary); color: #1d5a4d;">Update Stock</button>
                    </form>
                    <script>
                        document.getElementById('bookSearch').addEventListener('input', function(e) {
                            const val = e.target.value;
                            const list = document.getElementById('book-list');
                            const opts = list.options;
                            for (let i = 0; i < opts.length; i++) {
                                if (opts[i].value === val) {
                                    document.getElementById('bookId').value = opts[i].getAttribute('data-id');
                                    break;
                                }
                            }
                        });
                    </script>
                </div>
            </div>
        </div>

        <!-- Data Tables -->
        <div style="display: flex; gap: 40px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 400px;">
                <h2>Recent Sales History</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Ref</th>
                            <th>First name</th>
                            <th>Last name</th>
                            <th>Date</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(o => { %>
                            <tr>
                                <td style="color: #888;">REF-<%= o.id %></td>
                                <td><%= o.first_name %></td>
                                <td><%= o.last_name %></td>
                                <td><%= o.order_date.toLocaleDateString() %></td>
                                <td style="font-weight: 600; color: var(--primary);">$<%= o.total_amount %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>

                <h2>Order Item Details</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Book Title</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach(i => { %>
                            <tr>
                                <td style="color: #888;">#<%= i.order_id %></td>
                                <td><%= i.title %></td>
                                <td><%= i.quantity %></td>
                                <td style="font-weight: 600;">$<%= i.unit_price %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>